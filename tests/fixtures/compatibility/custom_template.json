{
  "capacity/trends.html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=yes\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"..&#x2F;status.css\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"..&#x2F;fa.all.min.css\">\n    <script>\n        window.TRENDS_JSON_URL = \"..&#x2F;trends.json\";\n    </script>\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n    <script src=\"..&#x2F;trends.js\" type=\"text/javascript\"></script>\n    <title>EESSI trends!</title>\n</head>\n\n<body>\n    \n    \n    \n    \n    \n    <header>Local template EESSI trends!</header>\n\n    <div class=\"content-row\">\n        \n\n        \n        <section class=\"infobox trends-section\">\n            <h2>No capacity data configured</h2>\n            <p>Enable an external metric source to render shared Stratum1 disk usage.</p>\n            <p><a href=\"..&#x2F;status&#x2F;index.html\">Back to status</a></p>\n        </section>\n        \n    </div>\n\n    \n    \n    <div class=\"footer\">\n    Last updated <GENERATED_AT> |\n    \n    <a href=\"..&#x2F;status&#x2F;index.html\">status</a>\n    \n    |\n    \n    <span>trends</span>\n    \n    | ops+o&#x27;hara@example.test\n</div>\n\n</body>\n\n</html>\n",
